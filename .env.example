# B loads explicit JSON configuration, not dotenv. No secret values belong here.
# Generate local files with npm run dev:init, then use:
# npm run server -- --config .local/b-demo/local-one.json
# Proxy configuration is inherited by Node --use-env-proxy; bypass loopback:
NO_PROXY=localhost,127.0.0.1,::1

# Optional PI setup names; replace endpoint/model locally, export secrets only in the server environment.
# VERDICT_PI_BASE_URL=https://your-provider.example/v1
# VERDICT_PI_MODEL=your-tool-capable-model-id
# VERDICT_PI_KEY_ENV=VERDICT_PI_API_KEY
# Never commit the actual VERDICT_PI_API_KEY value.
# VERDICT_PI_COMPAT=glm
# VERDICT_PI_OUTPUT_TOKENS=4096
# VERDICT_PI_REQUEST_TIMEOUT_MS=90000
# VERDICT_PI_FIRST_EVENT_TIMEOUT_MS=60000
# VERDICT_PI_STREAM_IDLE_TIMEOUT_MS=15000
# VERDICT_PI_MAX_INPUT_CHARS=64000

# Optional local read-only observer, installed with npm run obs:install.
# VERDICT_OBS_ENDPOINT=http://127.0.0.1:43190
# Load its write-only backend token via .local/observability/observer.env; never commit it.
