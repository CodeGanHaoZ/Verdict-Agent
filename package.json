{
  "name": "verdict-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "packages/protocol",
    "packages/core",
    "packages/evidence",
    "apps/verifier-cli",
    "packages/observations",
    "services/demo",
    "apps/server",
    "examples/consumer",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @verdict/web",
    "test": "npm run build && tsx --test packages/*/test/*.test.ts apps/verifier-cli/test/*.test.ts",
    "verify": "node apps/verifier-cli/dist/index.js",
    "capture:proof": "python3 fixtures/core/capture.py",
    "demo:a": "npm run build && tsx fixtures/core/export-demo.ts",
    "typecheck": "npm run build && tsc -p tsconfig.check.json",
    "test:b": "npm run build && tsx --test tests/integration/*.test.ts",
    "test:all": "npm test && npm run test:b",
    "dev:init": "npm run build && node scripts/dev/setup.mjs",
    "dev:start": "node scripts/dev/control.mjs start",
    "dev:stop": "node scripts/dev/control.mjs stop",
    "server": "node --use-env-proxy apps/server/dist/main.js",
    "demo:service": "node services/demo/dist/main.js",
    "example:b": "node examples/consumer/dist/main.js",
    "observe:b": "node --use-env-proxy scripts/dev/observe.mjs",
    "verify:b": "node scripts/dev/verify.mjs",
    "example:tools": "node examples/consumer/dist/tools-main.js",
    "verify:local": "npm run build && node scripts/dev/verify-local.mjs",
    "web": "npm run dev --workspace @verdict/web",
    "web:preview": "npm run preview --workspace @verdict/web",
    "test:e2e": "npm run build && playwright test",
    "pi:configure": "node scripts/dev/configure-pi.mjs",
    "verify:pi": "node scripts/dev/verify-pi.mjs",
    "verify:pi:local": "npm run build && node --use-env-proxy scripts/dev/verify-pi-local.mjs",
    "dataset:check": "node scripts/dev/check-agent-dataset.mjs",
    "test:360": "npm run build && node --test tests/integration/abnormal.test.mjs && node scripts/dev/verify-360.mjs offline",
    "verify:360": "npm run build && node --use-env-proxy scripts/dev/verify-360.mjs",
    "report:360": "node scripts/dev/report-360.mjs",
    "redteam:check": "node scripts/dev/check-redteam.mjs",
    "redteam:agent": "npm run build && node --use-env-proxy --import tsx scripts/dev/redteam-agent.ts",
    "redteam:boundaries": "npm run build && node scripts/dev/redteam-boundaries.mjs",
    "guard:rules": "tsx scripts/dev/guard-rules.ts",
    "test:guard": "npm run build && tsx --test tests/integration/guard.test.ts",
    "verify:guard": "npm run build && tsx scripts/dev/verify-guard.ts",
    "guard:configure": "npm run build && node scripts/dev/configure-guard.mjs",
    "verify:guard:live": "tsx scripts/dev/verify-guard-live.ts",
    "obs:install": "node scripts/dev/install-observability.mjs",
    "obs:start": "node scripts/dev/observability-control.mjs start",
    "obs:stop": "node scripts/dev/observability-control.mjs stop",
    "obs:configure": "node scripts/dev/observability-control.mjs configure",
    "verify:obs": "npm run build && tsx scripts/dev/verify-observability.ts",
    "redteam:indirect": "tsx scripts/dev/redteam-indirect.ts",
    "graph:record": "npm run build && tsx scripts/dev/record-agent-graph.ts",
    "test:graph": "npm run build && tsx --test tests/integration/graph*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "22.19.0",
    "viem": "2.57.3",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4"
  }
}
