{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "apps/verifier-cli/test/**/*.ts",
    "fixtures/core/*.ts",
    "tests/integration/**/*.ts",
    "tests/e2e/**/*.ts",
    "playwright.config.ts",
    "scripts/dev/redteam-agent.ts",
    "scripts/dev/guard-rules.ts",
    "scripts/dev/verify-guard.ts",
    "scripts/dev/verify-guard-live.ts"
  ]
}
